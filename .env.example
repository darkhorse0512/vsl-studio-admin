# Same Supabase project as the user app - Project Settings -> API Keys.
# The admin panel uses the publishable key too; administrator powers come from
# the signed-in user's role, enforced by RLS and the admin-users edge function.
# NEVER put the secret / service_role key or your OpenAI key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

VITE_APP_NAME=VSL Studio Admin
VITE_USER_APP_URL=http://localhost:5173

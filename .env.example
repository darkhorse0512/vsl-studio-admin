# Same Supabase project as the user app - Project Settings -> API.
# The admin panel uses the ANON key too; administrator powers come from the
# signed-in user's role, enforced by RLS and the admin-users edge function.
# NEVER put the service role key in a frontend app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_APP_NAME=VSL Studio Admin
VITE_USER_APP_URL=http://localhost:5173
